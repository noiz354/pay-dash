generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Better Auth core schema + app extensions (role, externalId, ledgerEntries)
// Reusable — NEXTJS #103 Better Auth, #106 Prisma; ADR-0004 Accepted (Better Auth swappable to Clerk via lib/auth.ts)
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // App extensions
  role          String    @default("member")
  externalId    String?   @unique(map: "externalId")
  sessions      Session[]
  accounts      Account[]
  ledgerEntries LedgerEntry[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model LedgerEntry {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  amount          Decimal   @db.Decimal(15, 2)
  currency        String   @default("IDR")
  status          String   @default("PENDING")
  referenceId     String?
  xenditPaymentId String?
  description     String?
  metadata        String   @default("{}")
}

// Minimal tenant anchor. Memberships and authorization are owned by the
// organization-access module and are intentionally absent here.
model Organization {
  id                  String                      @id @default(cuid())
  name                String
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  members             OrganizationMember[]
  providerConnections PaymentProviderConnection[]
  providerAccounts    ProviderAccount[]
  customers           CanonicalCustomer[]
  payments            CanonicalPayment[]
  refunds             CanonicalRefund[]
  paymentMethods      CanonicalPaymentMethod[]
  subscriptions       LocalSubscription[]
  payoutBatches       PayoutBatch[]
  platformTransfers   PlatformTransfer[]
  splitRules          SplitRule[]
  secretRecords       SecretRecord[]
  durableOperations   DurableOperation[]
  auditEvents         AuditEvent[]
}

// Organization membership (organization-access). Links a signed-in user to an
// organization with an RBAC role. Authorization is always resolved from this
// authenticated membership, never from the browser.
model OrganizationMember {
  id             String      @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  role           String      @db.VarChar(50)
  status         String      @default("ACTIVE") @db.VarChar(20)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_member")
}

// Identity shell only: credentials, capabilities, default selection, and the
// complete connection state machine belong to later modules.
model PaymentProviderConnection {
  id                String            @id @default(cuid())
  organizationId    String
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  provider          String            @db.VarChar(50)
  mode              String            @db.VarChar(10)
  status            String            @default("DRAFT") @db.VarChar(30)
  providerAccountId String?           @db.VarChar(255)
  // provider-connections / provider-secrets verification evidence (never a secret).
  capabilityManifest Json?
  requirements       Json?
  webhookHealthStatus String?         @db.VarChar(30)
  lastVerifiedAt     DateTime?
  createdByUserId    String?
  updatedByUserId    String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  providerAccounts       ProviderAccount[]
  providerCustomers      ProviderCustomer[]
  providerPayments       ProviderPayment[]
  providerRefunds        ProviderRefund[]
  providerPaymentMethods ProviderPaymentMethod[]
  providerRecurringPlans ProviderRecurringPlan[]
  providerPayoutAttempts ProviderPayoutAttempt[]
  platformTransfers      PlatformTransfer[]
  providerTransfers      ProviderTransfer[]
  splitRoutes            SplitRoute[]
  providerSplitRules     ProviderSplitRule[]
  secretRecords          SecretRecord[]
  operations             DurableOperation[]
  webhookDeliveries      WebhookDelivery[]

  @@unique([id, organizationId])
  @@index([organizationId, provider, mode])
  @@index([provider, providerAccountId])
}

model ProviderAccount {
  id                  String                    @id @default(cuid())
  organizationId      String
  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connectionId        String
  connection          PaymentProviderConnection @relation(fields: [connectionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  providerAccountId   String                    @db.VarChar(255)
  providerAccountType String                    @db.VarChar(50)
  canonicalStatus     String                    @default("UNKNOWN") @db.VarChar(30)
  providerStatus      String?                   @db.VarChar(100)
  capabilitiesSummary Json?
  lastSyncedAt        DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  outgoingTransfers   PlatformTransfer[]        @relation("TransferSource")
  incomingTransfers   PlatformTransfer[]        @relation("TransferDestination")
  splitRoutes         SplitRoute[]

  @@unique([id, connectionId])
  @@unique([connectionId, providerAccountId])
  @@index([organizationId])
}

model CanonicalCustomer {
  id                String                  @id @default(cuid())
  organizationId    String
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  merchantReference String                  @db.VarChar(255)
  displayName       String                  @db.VarChar(255)
  emailNormalized   String?                 @db.VarChar(320)
  appStatus         String                  @default("ACTIVE") @db.VarChar(30)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  providerCustomers ProviderCustomer[]
  payments          CanonicalPayment[]
  paymentMethods    CanonicalPaymentMethod[]
  subscriptions     LocalSubscription[]

  @@unique([id, organizationId])
  @@unique([organizationId, merchantReference])
  @@index([organizationId, emailNormalized])
}

model ProviderCustomer {
  id                  String                    @id @default(cuid())
  organizationId      String
  canonicalCustomerId String
  canonicalCustomer   CanonicalCustomer         @relation(fields: [canonicalCustomerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  connectionId        String
  connection          PaymentProviderConnection @relation(fields: [connectionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  providerCustomerId  String                    @db.VarChar(255)
  providerReference   String?                   @db.VarChar(255)
  providerStatus      String?                   @db.VarChar(100)
  lastSyncedAt        DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  paymentMethods      ProviderPaymentMethod[]

  @@unique([id, connectionId])
  @@unique([connectionId, providerCustomerId])
  @@unique([canonicalCustomerId, connectionId])
}

model CanonicalPayment {
  id                String             @id @default(cuid())
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customerId        String?
  customer          CanonicalCustomer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  merchantReference String             @db.VarChar(255)
  amount            Decimal            @db.Decimal(20, 4)
  currency          String             @db.Char(3)
  canonicalStatus   String             @default("PENDING") @db.VarChar(30)
  paymentKind       String             @db.VarChar(50)
  version           Int                @default(1)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  providerPayment   ProviderPayment?
  refunds           CanonicalRefund[]

  @@unique([id, organizationId])
  @@unique([organizationId, merchantReference])
  @@index([organizationId, canonicalStatus, createdAt])
}

model ProviderPayment {
  id                 String                    @id @default(cuid())
  organizationId     String
  canonicalPaymentId String                    @unique
  canonicalPayment   CanonicalPayment          @relation(fields: [canonicalPaymentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  connectionId       String
  connection         PaymentProviderConnection @relation(fields: [connectionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  providerPaymentId  String                    @db.VarChar(255)
  providerProductId  String?                   @db.VarChar(255)
  providerReference  String?                   @db.VarChar(255)
  providerStatus     String                    @db.VarChar(100)
  channelCategory    String?                   @db.VarChar(100)
  channelCode        String?                   @db.VarChar(100)
  cashflow           String?                   @db.VarChar(30)
  settlementStatus   String?                   @db.VarChar(100)
  feeAmount          Decimal?                  @db.Decimal(20, 4)
  netAmount          Decimal?                  @db.Decimal(20, 4)
  occurredAt         DateTime?
  providerUpdatedAt  DateTime?
  lastSyncedAt       DateTime
  refunds            ProviderRefund[]

  @@unique([id, connectionId])
  @@unique([connectionId, providerPaymentId])
  @@unique([canonicalPaymentId, organizationId])
  @@index([connectionId, providerStatus])
}

model CanonicalRefund {
  id                String            @id @default(cuid())
  organizationId    String
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  paymentId         String
  payment           CanonicalPayment  @relation(fields: [paymentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  merchantReference String            @db.VarChar(255)
  amount            Decimal           @db.Decimal(20, 4)
  currency          String            @db.Char(3)
  reasonCode        String?           @db.VarChar(100)
  canonicalStatus   String            @default("PENDING") @db.VarChar(30)
  version           Int               @default(1)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  providerRefund    ProviderRefund?

  @@unique([id, organizationId])
  @@unique([organizationId, merchantReference])
  @@index([paymentId, canonicalStatus])
}

model ProviderRefund {
  id                String                    @id @default(cuid())
  organizationId    String
  canonicalRefundId String                    @unique
  canonicalRefund   CanonicalRefund           @relation(fields: [canonicalRefundId, organizationId], references: [id, organizationId], onDelete: Restrict)
  providerPaymentId String
  providerPayment   ProviderPayment           @relation(fields: [providerPaymentId, connectionId], references: [id, connectionId], onDelete: Restrict)
  connectionId      String
  connection        PaymentProviderConnection @relation(fields: [connectionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  providerRefundId  String                    @db.VarChar(255)
  providerReference String?                   @db.VarChar(255)
  providerStatus    String                    @db.VarChar(100)
  failureCode       String?                   @db.VarChar(100)
  providerUpdatedAt DateTime?
  lastSyncedAt      DateTime

  @@unique([connectionId, providerRefundId])
  @@unique([canonicalRefundId, organizationId])
}

model CanonicalPaymentMethod {
  id                    String                 @id @default(cuid())
  organizationId        String
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customerId            String
  customer              CanonicalCustomer      @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  displayType           String                 @db.VarChar(50)
  displayLabel          String?                @db.VarChar(255)
  canonicalStatus       String                 @default("PENDING") @db.VarChar(30)
  reusability           String?                @db.VarChar(30)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  providerPaymentMethod ProviderPaymentMethod?

  @@unique([id, organizationId])
  @@index([organizationId, customerId])
}

model ProviderPaymentMethod {
  id                       String                    @id @default(cuid())
  organizationId           String
  canonicalPaymentMethodId String                    @unique
  canonicalPaymentMethod   CanonicalPaymentMethod    @relation(fields: [canonicalPaymentMethodId, organizationId], references: [id, organizationId], onDelete: Restrict)
  connectionId             String
  connection               PaymentProviderConnection @relation(fields: [connectionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  providerCustomerMappingId String
  providerCustomerMapping   ProviderCustomer          @relation(fields: [providerCustomerMappingId, connectionId], references: [id, connectionId], onDelete: Restrict)
  providerPaymentMethodId   String                    @db.VarChar(255)
  providerStatus            String                    @db.VarChar(100)
  providerType              String                    @db.VarChar(100)
  channelCode               String?                   @db.VarChar(100)
  maskedDetails             Json
  providerUpdatedAt         DateTime?
  lastSyncedAt              DateTime
  recurringPlans            ProviderRecurringPlan[]

  @@unique([connectionId, providerPaymentMethodId])
  @@unique([canonicalPaymentMethodId, organizationId])
  @@unique([canonicalPaymentMethodId, connectionId])
}

model LocalSubscription {
  id                     String                  @id @default(cuid())
  organizationId         String
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customerId             String
  customer               CanonicalCustomer       @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  merchantReference      String                  @db.VarChar(255)
  planKey                String                  @db.VarChar(255)
  entitlementStatus      String                  @db.VarChar(30)
  commercialStatus       String                  @db.VarChar(30)
  amount                 Decimal                 @db.Decimal(20, 4)
  currency               String                  @db.Char(3)
  intervalDefinition     Json
  startedAt              DateTime
  cancelledAt            DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  providerRecurringPlans ProviderRecurringPlan[]

  @@unique([id, organizationId])
  @@unique([organizationId, merchantReference])
  @@index([organizationId, commercialStatus])
}

model ProviderRecurringPlan {
  id                       String                    @id @default(cuid())
  organizationId           String
  localSubscriptionId      String
  localSubscription        LocalSubscription         @relation(fields: [localSubscriptionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  connectionId             String
  connection               PaymentProviderConnection @relation(fields: [connectionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  canonicalPaymentMethodId String
  providerPaymentMethod    ProviderPaymentMethod     @relation(fields: [canonicalPaymentMethodId, connectionId], references: [canonicalPaymentMethodId, connectionId], onDelete: Restrict)
  providerPlanId           String                    @db.VarChar(255)
  providerReference        String?                   @db.VarChar(255)
  providerStatus           String                    @db.VarChar(100)
  scheduleSummary          Json
  version                  Int
  effectiveFrom            DateTime
  effectiveTo              DateTime?
  providerUpdatedAt        DateTime?
  lastSyncedAt             DateTime

  @@unique([connectionId, providerPlanId])
  @@unique([localSubscriptionId, version])
}

model PayoutBatch {
  id                String            @id @default(cuid())
  organizationId    String
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  merchantReference String            @db.VarChar(255)
  name              String            @db.VarChar(255)
  currency          String            @db.Char(3)
  canonicalStatus   String            @default("DRAFT") @db.VarChar(30)
  scheduledFor      DateTime?
  version           Int               @default(1)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  recipients        PayoutRecipient[]

  @@unique([id, organizationId])
  @@unique([organizationId, merchantReference])
  @@index([organizationId, canonicalStatus, createdAt])
}

model PayoutRecipient {
  id                 String                  @id @default(cuid())
  organizationId     String
  batchId            String
  batch              PayoutBatch             @relation(fields: [batchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  recipientReference String                  @db.VarChar(255)
  name               String                  @db.VarChar(255)
  destinationRef     String                  @db.VarChar(255)
  amount             Decimal                 @db.Decimal(20, 4)
  currency           String                  @db.Char(3)
  canonicalStatus    String                  @default("PENDING") @db.VarChar(30)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  attempts           ProviderPayoutAttempt[]

  @@unique([id, organizationId])
  @@unique([batchId, recipientReference])
}

model ProviderPayoutAttempt {
  id                 String                    @id @default(cuid())
  organizationId     String
  recipientId        String
  recipient          PayoutRecipient           @relation(fields: [recipientId, organizationId], references: [id, organizationId], onDelete: Restrict)
  connectionId       String
  connection         PaymentProviderConnection @relation(fields: [connectionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  attemptNumber      Int
  providerPayoutId   String?                   @db.VarChar(255)
  providerReference  String?                   @db.VarChar(255)
  providerStatus     String                    @db.VarChar(100)
  failureCode        String?                   @db.VarChar(100)
  estimatedArrivalAt DateTime?
  lastSyncedAt       DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@unique([recipientId, attemptNumber])
  @@unique([connectionId, providerPayoutId])
}

model PlatformTransfer {
  id                           String             @id @default(cuid())
  organizationId               String
  organization                 Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  merchantReference            String             @db.VarChar(255)
  connectionId                 String
  connection                   PaymentProviderConnection @relation(fields: [connectionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  sourceProviderAccountId      String
  sourceProviderAccount        ProviderAccount    @relation("TransferSource", fields: [sourceProviderAccountId, connectionId], references: [id, connectionId], onDelete: Restrict)
  destinationProviderAccountId String
  destinationProviderAccount   ProviderAccount    @relation("TransferDestination", fields: [destinationProviderAccountId, connectionId], references: [id, connectionId], onDelete: Restrict)
  amount                       Decimal            @db.Decimal(20, 4)
  currency                     String             @db.Char(3)
  canonicalStatus              String             @default("PENDING") @db.VarChar(30)
  version                      Int                @default(1)
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt
  attempts                     ProviderTransfer[]

  @@unique([id, connectionId])
  @@unique([organizationId, merchantReference])
}

model ProviderTransfer {
  id                 String                    @id @default(cuid())
  organizationId     String
  platformTransferId String
  platformTransfer   PlatformTransfer          @relation(fields: [platformTransferId, connectionId], references: [id, connectionId], onDelete: Restrict)
  connectionId       String
  connection         PaymentProviderConnection @relation(fields: [connectionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  attemptNumber      Int
  providerTransferId String?                   @db.VarChar(255)
  providerReference  String?                   @db.VarChar(255)
  providerStatus     String                    @db.VarChar(100)
  lastSyncedAt       DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@unique([platformTransferId, attemptNumber])
  @@unique([connectionId, providerTransferId])
}

model SplitRule {
  id              String             @id @default(cuid())
  organizationId  String
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ruleKey         String             @db.VarChar(255)
  name            String             @db.VarChar(255)
  lifecycleStatus String             @default("DRAFT") @db.VarChar(30)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  versions        SplitRuleVersion[]

  @@unique([id, organizationId])
  @@unique([organizationId, ruleKey])
}

model SplitRuleVersion {
  id                 String              @id @default(cuid())
  organizationId     String
  splitRuleId        String
  splitRule          SplitRule           @relation(fields: [splitRuleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  version            Int
  effectiveFrom      DateTime?
  retiredAt          DateTime?
  approvalStatus     String              @default("DRAFT") @db.VarChar(30)
  createdAt          DateTime            @default(now())
  routes             SplitRoute[]
  providerSplitRules ProviderSplitRule[]

  @@unique([id, organizationId])
  @@unique([splitRuleId, version])
}

model SplitRoute {
  id                           String                    @id @default(cuid())
  organizationId               String
  splitRuleVersionId           String
  splitRuleVersion             SplitRuleVersion          @relation(fields: [splitRuleVersionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  routeReference               String                    @db.VarChar(255)
  connectionId                 String
  connection                   PaymentProviderConnection @relation(fields: [connectionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  destinationProviderAccountId String
  destinationProviderAccount   ProviderAccount           @relation(fields: [destinationProviderAccountId, connectionId], references: [id, connectionId], onDelete: Restrict)
  allocationType               String                    @db.VarChar(20)
  flatAmount                   Decimal?                  @db.Decimal(20, 4)
  percentAmount                Decimal?                  @db.Decimal(9, 6)
  currency                     String?                   @db.Char(3)

  @@unique([splitRuleVersionId, routeReference])
  @@index([connectionId, destinationProviderAccountId])
}

model ProviderSplitRule {
  id                  String                    @id @default(cuid())
  organizationId      String
  splitRuleVersionId  String
  splitRuleVersion    SplitRuleVersion          @relation(fields: [splitRuleVersionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  connectionId        String
  connection          PaymentProviderConnection @relation(fields: [connectionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  providerSplitRuleId String                    @db.VarChar(255)
  providerStatus      String                    @db.VarChar(100)
  lastSyncedAt        DateTime?

  @@unique([connectionId, providerSplitRuleId])
  @@unique([splitRuleVersionId, connectionId])
}

// ---------------------------------------------------------------------------
// Wave 0 foundation persistence (provider-secrets / durable-operations /
// audit-ledger / webhook-ingress / provider-connections verification evidence).
// Additive only; no secret is ever stored here — secretRef is an opaque key into
// the secret store, never the raw secret.
// ---------------------------------------------------------------------------

model SecretRecord {
  id              String                    @id @default(cuid())
  organizationId  String
  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connectionId    String
  connection      PaymentProviderConnection @relation(fields: [connectionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  provider        String                    @db.VarChar(50)
  mode            String                    @db.VarChar(10)
  secretRef       String                    @db.VarChar(255)
  credentialVersion Int                     @default(1)
  createdByUserId String?
  createdAt       DateTime                  @default(now())
  rotatedAt       DateTime?
  updatedAt       DateTime                  @updatedAt

  @@unique([connectionId, mode])
  @@index([organizationId, provider, mode])
}

model DurableOperation {
  id                 String                    @id @default(cuid())
  organizationId     String
  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connectionId       String
  connection         PaymentProviderConnection @relation(fields: [connectionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  actorId            String
  operationType      String                    @db.VarChar(50)
  resourceType       String                    @db.VarChar(50)
  resourceId         String?                   @db.VarChar(255)
  idempotencyKey     String                    @db.VarChar(255)
  requestHash        String                    @db.VarChar(64)
  amountMinor        String?                   @db.VarChar(64)
  currency           String?                   @db.Char(3)
  approvalState      String                    @default("NOT_REQUIRED") @db.VarChar(30)
  mfaProofRef        String?
  state              String                    @default("DRAFT") @db.VarChar(30)
  attemptCount       Int                       @default(0)
  providerReference  String?                   @db.VarChar(255)
  unknownOutcome     Boolean                   @default(false)
  version            Int                       @default(1)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@unique([idempotencyKey])
  @@index([organizationId, state])
  @@index([connectionId, operationType, resourceId])
}

model AuditEvent {
  id              String       @id @default(cuid())
  eventId         String       @unique
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorId         String
  action          String       @db.VarChar(50)
  outcome         String       @db.VarChar(20)
  metadata        Json
  version         Int          @default(1)
  createdAt       DateTime     @default(now())

  @@index([organizationId, action, createdAt])
}

model WebhookDelivery {
  id                 String                    @id @default(cuid())
  provider           String                    @db.VarChar(50)
  providerEventId    String                    @db.VarChar(255)
  type               String                    @db.VarChar(255)
  connectionId       String?
  connection         PaymentProviderConnection? @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  organizationId     String
  receivedAt         DateTime                  @default(now())
  verificationStatus String                    @default("UNVERIFIED") @db.VarChar(30)
  processingStatus   String                    @default("PENDING") @db.VarChar(30)
  attemptCount       Int                       @default(0)
  nextAttemptAt      DateTime?
  processedAt        DateTime?
  lastError          String?                   @db.VarChar(500)
  redactedPayload    Json
  createdAt          DateTime                  @default(now())

  @@unique([provider, providerEventId])
  @@index([organizationId, processingStatus, receivedAt])
}
