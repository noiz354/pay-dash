# Production environment template — copy to `.env.prod` and fill in real values.
#
#   cp apps/web/.env.prod.example apps/web/.env.prod
#
# `compose.yaml` mounts this file and sets `APP_ENV=production`, which makes
# `src/lib/env.ts` treat the values marked REQUIRED below as mandatory: the
# application refuses to boot without them. That is deliberate. Before this,
# every one of them was optional, so a deployment missing its webhook signing
# secret started normally and then returned a 500 for every inbound callback —
# silent, total payment-event loss with nothing failing at startup.
#
# Never commit the real `.env.prod`.

# --- Runtime identity ---------------------------------------------------------
# REQUIRED (set by compose.yaml). Keys production-only validation off this, not
# off NODE_ENV.
APP_ENV=production

# --- Database ---
# Overridden by compose.yaml to point at the `db` service.
DATABASE_URL=postgresql://postgres:postgres@db:5432/xendit

# --- Auth (Better Auth) ---
# REQUIRED. Minimum 32 characters, and the published development default
# ("dev-secret-change-in-prod-32-chars-long!!") is rejected outright — it is in a
# public repository, so anyone could forge a session cookie with it.
#   openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://your-production-origin.example.com

# --- Error reporting ---
# REQUIRED. Without a DSN there is no server-side error visibility at all.
# Also add your Sentry host to the CSP `connect-src` allowlist in
# `next.config.ts` (it accepts `https://*.ingest.sentry.io`) or browser reports
# will be blocked by the site's own policy.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Readiness probe ---
# Must stay "true" in production; `lib/env.ts` refuses "false" when
# APP_ENV=production. `/api/ready` returns 503 while the database is
# unreachable, which takes the instance out of rotation.
READY_REQUIRE_DB=true

# --- Tracing ---
OTEL_SERVICE_NAME=paydash-web
# OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Xendit ---
# Both REQUIRED. The secret key signs outbound calls; the callback token
# authenticates inbound webhooks via constant-time comparison.
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# --- Stripe ---
# Both REQUIRED. The webhook secret verifies the raw-body signature.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Provider secret store ---
# LIVE provider activation is refused unless SECRET_STORE_MODE=kms with a valid
# key id. "local" is the development AES-256-GCM adapter and is not sufficient
# for production key material.
SECRET_STORE_MODE=kms
SECRET_STORE_KMS_KEY_ID=
SECRET_STORE_KEY=

# --- Trusted public origin ---
# Used for webhook callback URLs, redirects and OAuth. Must be the real public
# origin. NOTE: not yet consumed by payment-link share URLs, which are still a
# hardcoded placeholder — roadmap item 4.5.
PAYMENTS_PUBLIC_ORIGIN=https://your-production-origin.example.com
NEXT_PUBLIC_APP_URL=https://your-production-origin.example.com

# --- Auth enforcement ---
# Leave unset or "strict". "off" disables every auth check; "preview" allows a
# bypass header. Neither belongs in production.
AUTH_ENFORCED=strict
# Leave UNSET in production. Setting this to "true" serves the single-tenant demo
# organization (org_demo / OWNER) to requests that could not be authenticated —
# only for a hosted demo or a staging showcase, never for a live deployment.
PAYDASH_ENABLE_DEMO_ORG=

# --- MCP ---
MCP_ACCESS_TOKEN=

# --- Product analytics (optional) ---
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- AI Journal (Firebase + Gemini) ---
# Prefer Workload Identity / ADC on Cloud Run over a service-account key file.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
GOOGLE_CLOUD_PROJECT=
GEMINI_API_KEY_SECRET_ID=GEMINI_API_KEY
GEMINI_API_KEY_SECRET_VERSION=latest
GEMINI_API_KEY_SECRET_RESOURCE=
GEMINI_MODEL=gemini-3.6-flash
# These three must stay unset in production. Each one weakens authentication or
# moves key material out of Secret Manager.
AI_JOURNAL_STORAGE_MODE=
AI_JOURNAL_ALLOW_TEST_AUTH=false
AI_JOURNAL_ALLOW_ENV_GEMINI_KEY=false
