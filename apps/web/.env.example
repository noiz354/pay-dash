# Copy to `.env` (Next.js reads it from this directory) and fill in real values.
# Never commit the real `.env`. Values below are illustrative placeholders.

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xendit

# --- Auth (Better Auth) ---
# The value below is a published development default and is REJECTED when
# APP_ENV=production. Generate a real one with: openssl rand -base64 48
BETTER_AUTH_SECRET=dev-secret-change-in-prod-32-chars-long!!
BETTER_AUTH_URL=http://localhost:3000
# "strict" (default) enforces auth everywhere. "off" disables every check and
# "preview" allows a bypass header — neither belongs in production. Playwright
# runs with "off"; see `playwright.config.ts`.
AUTH_ENFORCED=strict
# May an unauthenticated request be served the single-tenant demo organization
# (org_demo / OWNER)? With no override the answer is the inverse of "is this
# production": development and test keep the demo dataset that makes the
# dashboard usable without a database, production never serves financial data to
# a request it could not authenticate.
#   true  -> permit even in production (a hosted demo or staging showcase)
#   false -> refuse even in development; this is how the strict path is exercised
#            locally without a database
PAYDASH_ENABLE_DEMO_ORG=

# --- App / observability ---
# APP_ENV drives production-only secret validation in `src/lib/env.ts`. Anything
# other than "production" keeps the optional-with-defaults behaviour below, so
# local development is unaffected. For a real deployment use `.env.prod.example`.
APP_ENV=development
SENTRY_DSN=
# Read by `src/instrumentation-client.ts`; declared in the env schema so a value
# that decides whether browser error reporting exists is validated at build time.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# OTEL service name. Was hardcoded to "xendit-app", which put every trace under a
# name that does not match the product.
OTEL_SERVICE_NAME=paydash-web
# `/api/ready` returns 503 while the database is unreachable. Set to "false" for
# local development without Postgres; refused when APP_ENV=production.
READY_REQUIRE_DB=false

# --- Gen AI Academy Ideathon: Firebase + Gemini Journal ---
# Firebase public web app config (safe for browser, restrict domains in Firebase console)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server-side Firebase Admin. On Cloud Run prefer ADC + FIREBASE_PROJECT_ID only.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Gemini key is read from Google Cloud Secret Manager in production.
GOOGLE_CLOUD_PROJECT=
GEMINI_API_KEY_SECRET_ID=GEMINI_API_KEY
GEMINI_API_KEY_SECRET_VERSION=latest
GEMINI_API_KEY_SECRET_RESOURCE=
GEMINI_MODEL=gemini-3.6-flash
# Local-only escape hatches for tests/dev previews. Do not enable in production.
# Each one weakens authentication or moves key material out of Secret Manager.
AI_JOURNAL_STORAGE_MODE=
AI_JOURNAL_ALLOW_TEST_AUTH=false
AI_JOURNAL_ALLOW_ENV_GEMINI_KEY=false
GEMINI_API_KEY=

# --- Xendit (xendit-node) ---
# Both are REQUIRED when APP_ENV=production: without the webhook token, inbound
# callbacks cannot be authenticated and the route returns 500 for every one.
XENDIT_SECRET_KEY=xnd_development_xxxxxxxx
XENDIT_WEBHOOK_TOKEN=wh_xxxxxxxx

# --- Stripe (stripe SDK) ---
# Both are REQUIRED when APP_ENV=production (raw-body signature verification).
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# --- Provider secret store (provider-secrets) ---
# "local" = development/test AES-256-GCM adapter. LIVE activation is refused
# unless "kms" is set with a production-grade KMS backend + key id.
SECRET_STORE_MODE=local
SECRET_STORE_KEY=
SECRET_STORE_KMS_KEY_ID=

# --- Trusted public origin (webhook callback URLs / redirects / OAuth) ---
PAYMENTS_PUBLIC_ORIGIN=https://pay.example.com
